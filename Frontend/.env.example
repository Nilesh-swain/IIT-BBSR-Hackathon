# --- ANTARIKSH FRONTEND CONFIG ---

# 1. API CONNECTION (CRITICAL)
# For local dev with Vite proxy, use: /api
# For production (Vercel/Netlify), use your deployed Render URL:
VITE_API_BASE_URL=https://iit-bbsr-hackathon-1.onrender.com/api

# 2. NASA UPLINK (OPTIONAL)
# Defaults to DEMO_KEY if not provided, but highly recommended you use your own.
VITE_NASA_API_KEY=DEMO_KEY
VITE_NASA_BASE_URL=https://api.nasa.gov/neo/rest/v1
